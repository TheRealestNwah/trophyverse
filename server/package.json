{
  "name": "unified-achievement-manager-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed-levels": "ts-node src/db/seedLevels.ts",
    "db:rescore-all": "ts-node src/db/rescoreAll.ts",
    "db:add-game-merge-candidates-table": "ts-node src/db/addGameMergeCandidatesTable.ts",
    "db:encrypt-platform-credentials": "ts-node src/db/encryptPlatformCredentials.ts",
    "match": "ts-node src/db/runMatching.ts",
    "fix:platinum-inflation": "ts-node src/db/fixPlatinumInflation.ts",
    "fix:rarity-tiering": "ts-node src/db/fixRarityTiering.ts",
    "fix:xbox-timestamps": "ts-node src/db/fixBogusXboxTimestamps.ts",
    "fix:xbox-console-overclaim": "ts-node src/db/fixXboxConsoleOverclaim.ts",
    "fix:steam-landscape-covers": "ts-node src/db/fixSteamLandscapeCovers.ts",
    "fix:skyrim-special-edition-psn": "ts-node src/db/splitSkyrimSpecialEditionPsn.ts"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/passport": "^1.0.16",
    "@types/pg": "^8.11.6",
    "eslint": "^9.39.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
