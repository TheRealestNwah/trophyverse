DATABASE_URL=postgres://postgres:postgres@localhost:5432/uam
# Optional: when unset, the dashboard asks for a key on first run and stores
# it encrypted in the database.
STEAM_API_KEY=get_one_from_https://steamcommunity.com/dev/apikey
SESSION_SECRET=change_me_to_a_random_string
# Optional: defaults to http://<HOST or localhost>:<PORT>.
BASE_URL=http://localhost:3000
PORT=3000
# Optional: bind to one interface only (the desktop app uses 127.0.0.1).
# HOST=127.0.0.1

# Optional: a per-user data folder. When set, SESSION_SECRET and
# CREDENTIAL_ENCRYPTION_KEY are generated there on first run if not provided,
# and uploaded cover/icon overrides are stored there instead of server/public.
# UAM_DATA_DIR=

# Optional: periodic background re-sync of every linked account instead of
# manual/on-demand only (see server/src/scheduler.ts). Off by default.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=360
